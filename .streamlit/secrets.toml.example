# Diese Werte trägst du in Streamlit Cloud unter "App settings → Secrets" ein
# (lokal: Datei .streamlit/secrets.toml anlegen – wird NICHT nach GitHub hochgeladen).

SHOPIFY_STORE = "unorganizedbrand.myshopify.com"

# Variante A (empfohlen, neue Shopify-Apps aus dem Dev Dashboard):
SHOPIFY_CLIENT_ID = "..."
SHOPIFY_CLIENT_SECRET = "shpss_..."

# Variante B (nur falls du schon einen festen Admin-API-Token "shpat_..." hast):
# SHOPIFY_ACCESS_TOKEN = "shpat_..."

# Optional: Passwort für die Seite
APP_PASSWORD = "dein-passwort"
